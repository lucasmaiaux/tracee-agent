# ============================================
.env
.env.local
secrets/
*.key
*.pem

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Environnements virtuels
.venv/
venv/
ENV/
env/

# Tests et coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
.ruff_cache/

# ============================================
# Packaging
# ============================================
# PyInstaller : les .spec générés à la volée sont jetables, le nôtre est la recette
# de build et doit suivre le code.
*.spec
!packaging/*.spec
build/
dist/

# Paquets construits
*.deb
*.rpm
*.pkg
*.exe
*.dmg
*.AppImage
packaging/output/

# ============================================
# IDE et éditeurs
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Données et captures de test
# ============================================
